# Copiá este archivo como hotel_agent_app/.env y completá tu proyecto.
#
# GOOGLE_CLOUD_LOCATION va en `global` a propósito: gemini-3.5-flash NO está
# disponible en us-central1. Ver docs/troubleshooting.md
GOOGLE_GENAI_USE_ENTERPRISE=1
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global
